# Placeholders only. Export variables in your shell; Django does not load .env automatically.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-local-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Omit DATABASE_URL for SQLite in .local/development.sqlite3.
# DATABASE_URL=postgresql://bearings:local-only@127.0.0.1:5432/bearings
# Live connectors are opt-in and operator-configured, never supplied through organization forms.
NETBOX_URL=
NETBOX_TOKEN=
# Required for each central source: tenant ID in database; site, role and type below.
NETBOX_SITE_ID=
NETBOX_ROLE_ID=
NETBOX_DEVICE_TYPE_ID=
VULNERABILITY_LOOKUP_URL=https://vulnerability.circl.lu
CONTACT_REVIEW_DAYS=183

# Cloud proxy-only DNS: opt in only with an operator-approved HTTPS_PROXY and egress allowlist.
CONNECTOR_PROXY_DNS=0
CONNECTOR_ALLOWED_HOSTS=vulnerability.circl.lu
# NETBOX_ALLOW_PRIVATE=0
