# Placeholders only. Export variables in your shell; Django does not load .env automatically.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-local-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Omit DATABASE_URL for SQLite in .local/development.sqlite3.
# DATABASE_URL=postgresql://bearings:local-only@127.0.0.1:5432/bearings
# Live connectors are opt-in and operator-configured, never supplied through organization forms.
# Configure endpoints, capability and defaults per NetBoxInstance in platform admin.
# Store only each credential variable NAME there; provide values securely outside Git.
NETBOX_CENTRAL_TOKEN=
NETBOX_COMPANY_A_TOKEN=
# Add approved NetBox hostnames to CONNECTOR_ALLOWED_HOSTS in proxy-DNS mode.
VULNERABILITY_LOOKUP_URL=https://vulnerability.circl.lu
MOSP_URL=https://objects.monarc.lu
MOSP_PUBLISHER=MONARC
CONTACT_REVIEW_DAYS=183

# Cloud proxy-only DNS: opt in only with an operator-approved HTTPS_PROXY and egress allowlist.
CONNECTOR_PROXY_DNS=0
CONNECTOR_ALLOWED_HOSTS=vulnerability.circl.lu,objects.monarc.lu
# Optional public-connector overrides for a proxy-only runtime; leave unset for direct networking.
# MOSP_PROXY_DNS=1
# VULNERABILITY_LOOKUP_PROXY_DNS=1

# Optional Docker starter ports (.env is read by Compose, unlike bare Django).
BEARINGS_PORT=8000
NETBOX_PORT=8443
# Optional integrated HTTPS browser workspace in the SSO Docker lab.
BEARINGS_CANVAS_PORT=9441
# Independently operated deployments: enable only after browser/IdP/frame-policy acceptance.
# BEARINGS_CANVAS_ORIGIN=https://bearings.example.org
# BEARINGS_CANVAS_FRAME_ORIGINS=["https://netbox.example.org","https://flowintel.example.org"]
# DJANGO_TRUST_PROXY_SSL=1  # Only behind a trusted edge overwriting X-Forwarded-Proto.

# Explicit CIRCL campaign bounds; complete previews are rejected above these limits.
BEARINGS_CIRCL_CAMPAIGN_MAX_REVIEWS=10000
BEARINGS_CIRCL_CAMPAIGN_MAX_RECIPIENTS=2000
