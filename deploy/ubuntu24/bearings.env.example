PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
DJANGO_SETTINGS_MODULE=config.production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_A_GENERATED_PRIVATE_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=bearings.circl.lu
BEARINGS_PUBLIC_URL=https://bearings.circl.lu
BEARINGS_DATA_DIR=/var/lib/bearings
DJANGO_STATIC_ROOT=/var/www/bearings/static
DATABASE_URL=postgresql://bearings@/bearings
PGHOST=/var/run/postgresql
BEARINGS_PUBLIC_REGISTRATION=0
BEARINGS_SHOWCASE=0
BEARINGS_SERVICE_MAIL_TRANSPORT=file
BEARINGS_NOTIFICATION_TRANSPORT=file
DJANGO_DEFAULT_FROM_EMAIL=bearings@circl.lu
BEARINGS_LINUX_CLIENT_DIR=/var/www/bearings/clients
# Optional absolute path to one reviewed Windows client release.
# BEARINGS_WINDOWS_CLIENT_DIR=/var/www/bearings/windows-client/RELEASE
# Set approved SMTP/SSO/connector settings here before enabling those workflows.
# This file is read by systemd/root; keep it root-owned mode 0600 and outside Git.

# Vitrine background tiles (operator setting); empty disables external tiles.
BEARINGS_MAP_TILE_URL=https://geo.circl.lu/hot/{z}/{x}/{y}.png
