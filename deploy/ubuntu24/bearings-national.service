[Unit]
Description=Bearings national overview refresh
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
User=bearings
Group=www-data
WorkingDirectory=/opt/bearings
EnvironmentFile=/etc/bearings/bearings.env
StateDirectory=bearings
StateDirectoryMode=0700
ExecStart=/opt/bearings/.venv/bin/python manage.py refresh_national --watch --limit 500
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/bearings
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
